<layouts>
<layout id="MainLayout" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <label id="time_text"
        x="center"
        y="7%"
        font="Gfx.FONT_MEDIUM"
        justification="Gfx.TEXT_JUSTIFY_CENTER"
        color="Gfx.COLOR_WHITE" />

    <label id="cadence_text"
        x="22%"
        y="27%"
        font="Gfx.FONT_SMALL"
        justification="Gfx.TEXT_JUSTIFY_LEFT"
        color="Gfx.COLOR_BLUE" />

    <label id="cadence_percent"
        x="82%"
        y="27%"
        font="Gfx.FONT_SMALL"
        justification="Gfx.TEXT_JUSTIFY_RIGHT"
        color="Gfx.COLOR_BLUE" />

    <label id="cadence_zone"
        x="14%"
        y="39%"
        font="Gfx.FONT_XTINY"
        justification="Gfx.TEXT_JUSTIFY_LEFT"
        color="Gfx.COLOR_LT_GRAY" />

    <label id="cadence_range"
        x="88%"
        y="39%"
        font="Gfx.FONT_XTINY"
        justification="Gfx.TEXT_JUSTIFY_RIGHT"
        color="Gfx.COLOR_LT_GRAY" />

    <label id="heartrate_text"
        x="30%"
        y="52%"
        font="Gfx.FONT_SMALL"
        justification="Gfx.TEXT_JUSTIFY_LEFT"
        color="Gfx.COLOR_RED" />

    <label id="distance_text"
        x="86%"
        y="52%"
        font="Gfx.FONT_SMALL"
        justification="Gfx.TEXT_JUSTIFY_RIGHT"
        color="Gfx.COLOR_PURPLE" />

    <label id="pace_text"
        x="84%"
        y="70%"
        font="Gfx.FONT_SMALL"
        justification="Gfx.TEXT_JUSTIFY_RIGHT"
        color="Gfx.COLOR_GREEN" />

</layout>

<!-- Watch face with date and time Layout -->
<layout id="WatchFace">
    <label id="Date"            
    x="center" 
    y="31%"
    font="Graphics.FONT_MEDIUM"
    justification="Graphics.TEXT_JUSTIFY_CENTER" />

    <label id="HoursAndMinutes" 
    x="43%"
    y="52%"
    font="Graphics.FONT_LARGE" 
    justification="Graphics.TEXT_JUSTIFY_CENTER" />

    <label id="AmPm" 
    x="72%"
    y="54%"
    font="Graphics.FONT_SMALL"
    justification="Graphics.TEXT_JUSTIFY_CENTER" />

</layout>
</layouts>
